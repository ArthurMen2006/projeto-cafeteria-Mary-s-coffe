generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  price       Float
  quantity    Int
  description String?

  requests    Request[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Request {
  id        Int      @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  total     Float

  createdAt DateTime @default(now())
}
